pipeline {
    agent any
    environment {
        DOCKER_IMAGE = 'nxshh/nodejs-demo-app'
    }
    stages {
        stage('Checkout') {
            steps {
                git 'https://github.com/nxshh/DevOps_Internship.git'
            }
        }
        stage('Build & Test') {
            steps {
                sh '''
                docker run --rm -v $WORKSPACE:/app -w /app node:18 npm install
                docker run --rm -v $WORKSPACE:/app -w /app node:18 npm test || true
                '''
            }
        }
        stage('Docker Build & Push') {
            steps {
                sh '''
                docker build -t $DOCKER_IMAGE .
                echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin
                docker push $DOCKER_IMAGE
                '''
            }
        }
    }
}

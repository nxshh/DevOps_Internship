pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                sh '''
                docker run --rm -v $PWD:/app -w /app node:18 npm install
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                docker run --rm -v $PWD:/app -w /app node:18 npm test
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh 'docker build -t nodejs-jenkins-app .'
            }
        }
    }
}

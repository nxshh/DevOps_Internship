pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "nxshh/nodejs-demo-app"
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                git branch: 'main',
                url: 'https://github.com/nxshh/DevOps_Internship.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                dir('task-02') {
                    sh 'docker build -t $DOCKER_IMAGE .'
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished!'
        }
        success {
            echo 'Pipeline successful.'
        }
        failure {
            echo 'Pipeline failed. Check logs.'
        }
    }
}

pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'nxshh/nodejs-demo-app'  // your DockerHub image name
        DOCKER_USERNAME = credentials('docker-username') // Jenkins credentials ID
        DOCKER_PASSWORD = credentials('docker-password') // Jenkins credentials ID
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                git branch: 'main', url: 'https://github.com/nxshh/DevOps_Internship.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing npm dependencies...'
                // On Windows, avoid docker. Run directly in Jenkins workspace
                bat 'npm install'
            }
        }

        stage('Run Tests') {
            steps {
                echo 'Running tests...'
                bat 'npm test || exit 0'  // don’t fail pipeline on test errors yet
            }
        }

        stage('Build Docker Image') {
            when {
                expression { isUnix() } // only build Docker image on Linux/WSL2
            }
            steps {
                echo 'Building Docker image...'
                sh '''
                    docker build -t $DOCKER_IMAGE .
                    echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin
                    docker push $DOCKER_IMAGE
                '''
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished!'
        }
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Check logs.'
        }
    }
}

pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "nxshh/nodejs-demo-app"
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                git branch: 'main',
                url: 'https://github.com/nxshh/DevOps_Internship.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing dependencies...'
                sh '''
                docker run --rm \
                -v $PWD:/app \
                -w /app node:18 \
                npm install
                '''
            }
        }

        stage('Run Tests') {
            steps {
                echo 'Running tests...'
                sh '''
                docker run --rm \
                -v $PWD:/app \
                -w /app node:18 \
                npm test
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                sh 'docker build -t $DOCKER_IMAGE .'
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished!'
        }
        success {
            echo 'Pipeline successful.'
        }
        failure {
            echo 'Pipeline failed. Check logs.'
        }
    }
}
